# OCI auth (used by lib/oci-functions-client.js)
OCI_TENANCY_OCID=ocid1.tenancy.oc1..exampleuniqueID
OCI_USER_OCID=ocid1.user.oc1..exampleuniqueID
OCI_FINGERPRINT=aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99
# Paste the private key with literal \n for line breaks (single line, double-quoted).
OCI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIExampleKeyMaterial...\n-----END PRIVATE KEY-----"
OCI_REGION=ap-mumbai-1

# api/auth/google/login.js — builds the Google consent URL. Public client ID
# only; the secret stays server-side in the google-oauth-callback function's
# own OCI app config, never in this frontend.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Must be identical here and in the OCI google-oauth-callback function's
# GOOGLE_REDIRECT_URI config, and is the exact URL to register as the
# authorized redirect URI in Google Cloud Console.
GOOGLE_REDIRECT_URI=https://your-vercel-app.vercel.app/api/auth/google/callback

# api/auth/google/callback.js — invokes the google-oauth-callback function
# (chess-auth-fn application) to exchange the code and get back {token, user}
GOOGLE_OAUTH_CALLBACK_FUNCTION_ID=ocid1.fnfunc.oc1..exampleuniqueID
GOOGLE_OAUTH_CALLBACK_INVOKE_ENDPOINT=https://exampleuniqueID.apigw.ap-mumbai-1.oci.customer-oci.com

# api/auth/signup.js — invokes the signup function (chess-auth-fn application)
SIGNUP_FUNCTION_ID=ocid1.fnfunc.oc1..exampleuniqueID
SIGNUP_INVOKE_ENDPOINT=https://exampleuniqueID.apigw.ap-mumbai-1.oci.customer-oci.com

# api/auth/signin.js — invokes the signin function (chess-auth-fn application)
SIGNIN_FUNCTION_ID=ocid1.fnfunc.oc1..exampleuniqueID
SIGNIN_INVOKE_ENDPOINT=https://exampleuniqueID.apigw.ap-mumbai-1.oci.customer-oci.com

# api/auth/request-password-reset.js — invokes the request-password-reset
# function (chess-auth-fn application)
REQUEST_PASSWORD_RESET_FUNCTION_ID=ocid1.fnfunc.oc1..exampleuniqueID
REQUEST_PASSWORD_RESET_INVOKE_ENDPOINT=https://exampleuniqueID.apigw.ap-mumbai-1.oci.customer-oci.com

# api/auth/reset-password.js — invokes the reset-password function
# (chess-auth-fn application)
RESET_PASSWORD_FUNCTION_ID=ocid1.fnfunc.oc1..exampleuniqueID
RESET_PASSWORD_INVOKE_ENDPOINT=https://exampleuniqueID.apigw.ap-mumbai-1.oci.customer-oci.com

# Optional — only needed if the frontend is ever served from a different
# origin than this Vercel app; otherwise the callback redirect is relative.
#
# NOTE: FRONTEND_URL also has a second, required use on the OCI side: the
# request-password-reset function's own FRONTEND_URL config (set via
# `fn config app`, not here) is what it prepends to build the emailed
# /reset-password?token=... link, so it must point at wherever this
# frontend's /reset-password page is actually served.
# FRONTEND_URL=https://your-frontend-domain.example.com
